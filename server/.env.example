# ==============================================================================
# RouteWise Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the backend server:
#   cp server/.env.example server/.env
#
# IMPORTANT: In production, NEVER commit actual secrets to source control.
# Generate high-entropy random secrets with at least 32 characters:
#   openssl rand -hex 32
# ==============================================================================

# Application Environment ('production', 'development', 'test')
# In production, demo login endpoints and weak secret fallbacks are strictly disabled.
NODE_ENV=production

# Server listening port (default: 5050; fallback on macOS: 5055)
PORT=5050

# MongoDB Atlas Connection String
# Ensure TLS/SSL is enabled (standard in Atlas), replica set is configured,
# and server IP addresses or VPC peering are whitelisted under Atlas Network Access.
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/routewise?retryWrites=true&w=majority

# Permitted Client Origin(s) for Cross-Origin Resource Sharing (CORS)
# Multiple origins may be separated by commas (e.g., https://routewise.example.com,https://app.routewise.example.com)
CLIENT_ORIGIN=https://routewise.example.com

# JWT Secret for Shipper and Transporter Authentication
# MANDATORY in production: Must be at least 32 characters long.
# Generate via: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_32_character_jwt_secret_string

# JWT Secret for Internal Ops / Admin Dashboard Authentication
# MANDATORY in production: Must be at least 32 characters long.
# Generate via: openssl rand -hex 32
ADMIN_TOKEN_SECRET=replace_with_a_secure_random_32_character_admin_jwt_secret

# Administrator Authentication Credentials
# Used for initial admin login to access verification and trust management dashboards.
ADMIN_USERNAME=ops_admin
ADMIN_PASSWORD=replace_with_a_strong_random_admin_password

# Persistent File Storage Directory
# When running on containerized infrastructure (Docker / ECS / Kubernetes),
# mount a persistent disk volume to this path to prevent file loss across deployments.
# Ephemeral local disks (Heroku, Render default disk) will lose files on restart!
STORAGE_PATH=/data/routewise/storage

# Demo Authentication Control
# Set to 'false' (or omit) in production.
# Only set to 'true' in staging or demo sandbox environments if demo 1-click accounts are needed.
ALLOW_DEMO_AUTH=false

# Demo Database Seeding Control
# Set to 'false' in production. Set to 'true' in staging to populate pre-configured test fixtures.
SEED_DEMO_ACCOUNTS=false
